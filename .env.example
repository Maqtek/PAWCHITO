# Скопировать в .env и заполнить. Реальные значения в репозиторий не коммитим.
# Закомментированные переменные необязательны, в них указаны значения по умолчанию.

# --- База данных ---
# Учётные данные контейнера db. Пароль без символов @ : / — он подставляется в URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pawchito
# Для бэкенда, запущенного без Docker; должен совпадать с POSTGRES_* выше.
# В Docker compose собирает адрес сам, с хостом db.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pawchito

# --- Redis: логи ---
# Для бэкенда без Docker; в Docker compose подставляет хост redis.
REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=INFO
# LOG_STREAM=logs
# LOG_RETENTION_DAYS=14

# --- Авторизация ---
# Обязательно, не короче 32 символов, без него бэкенд не стартует. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# true — cookie только по HTTPS (http://localhost браузеры считают безопасным)
# COOKIE_SECURE=true

# --- Прочее ---
# TIMEZONE=Europe/Moscow

# --- Фронтенд в Docker ---
# true — фронт в Docker работает на моках MSW вместо бэкенда
# VITE_MOCKS=true

# --- Администратор (python -m app.seed при старте бэкенда) ---
# Создаётся один раз; если пользователь с таким email уже есть, пароль не меняется.
# Сменить пароль: docker compose exec backend python -m app.cli reset-admin-password EMAIL
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
