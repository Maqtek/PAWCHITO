# Скопировать в .env и заполнить. Реальные значения в репозиторий не коммитим.
# Закомментированные переменные необязательны: в них значения по умолчанию из backend/app/core/config.py.

# --- База данных ---
# postgresql+psycopg2://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/БАЗА
# ХОСТ: локально — localhost, в Docker — db (имя сервиса в docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pawchito

# --- Redis: логи ---
# ХОСТ: локально — localhost, в Docker — redis
REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=INFO
# LOG_STREAM=logs
# LOG_RETENTION_DAYS=14

# --- Авторизация ---
# Обязательно, не короче 32 символов, без него бэкенд не стартует. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# true — cookie только по HTTPS (http://localhost браузеры считают безопасным)
# COOKIE_SECURE=true

# --- Прочее ---
# TIMEZONE=Europe/Moscow
