# Прод: фронт, API и фото на одном домене — refresh-cookie работает без CORS (Стек, «Авторизация»).
# DOMAIN и ACME_EMAIL — из окружения контейнера (.env через docker-compose.prod.yml).
# Сертификат Let's Encrypt Caddy получает и продлевает сам, хранит в томе caddy_data.
{
	# почта для Let's Encrypt: предупреждения, если продлить сертификат не удаётся
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# поддомены не включаем: на них может не быть HTTPS
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# сайт нельзя встроить во фрейм — защита от кликджекинга
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# API. Тела запросов — JSON, 1 МБ с запасом; исключение — загрузка фото питомца:
	# файл до 5 МБ (проверяет бэкенд) плюс обёртка multipart
	handle /api/* {
		@photo {
			method PUT
			path /api/clinic/pets/*/photo
		}
		handle @photo {
			request_body {
				max_size 6MB
			}
			reverse_proxy backend:8000
		}
		handle {
			request_body {
				max_size 1MB
			}
			reverse_proxy backend:8000
		}
	}

	# Фото питомцев из тома media. Имя — случайный UUID, новое фото получает новое имя,
	# так что файл по адресу не меняется — кэш на год
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Файлы сборки Vite с хешем в имени тоже не меняются. Отсутствующий файл — 404,
	# а не index.html: иначе браузер получит HTML вместо скрипта
	handle /assets/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Остальные пути — SPA: index.html, маршруты разбирает React Router.
	# no-cache: после деплоя браузер сразу берёт новый index.html со ссылками на новые файлы
	handle {
		root * /srv/frontend
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
